---
// Render a waving kaomoji with randomly-chosen facial features.

import type { BaseProps } from "@recivi/pf/types/props";

type Props = BaseProps;
const { class: className, ...attrs } = Astro.props;
---

<random-kaomoji
	class:list={["random-kaomoji", className]}
	{...attrs}
	aria-hidden="true"
>
	<span class="face">ʕ • ᴥ • ʔ</span>
	<span class="hand">ﾉ</span>
	<span class="sr-only">Hello!</span>
</random-kaomoji>

<style>
	@layer components {
		.random-kaomoji {
			@media (scripting: enabled) {
				cursor: pointer;
			}

			.hand {
				@media not (prefers-reduced-motion: reduce) {
					display: inline-block;
					transform-origin: bottom left;
					animation: wave 2s infinite;
				}
			}
		}

		@keyframes wave {
			50% {
				transform: rotate(20deg);
			}
		}
	}
</style>

<script>
	const EDGE_PAIRS = [
		["ʕ", "ʔ"],
		["(", ")"],
		["[", "]"],
	] as const;
	const EYE_PAIRS = [
		["•", "•"],
		["ˇ", "ˇ"],
		["❛", "❛"],
		["^", "^"],
		["＾", "＾"],
		["´•", "•`"],
		["◕", "◕"],
		["❤", "❤"],
		["˘", "˘"],
		["ᵒ", "ᵒ"],
		[" ͡°", " ͡°"],
	] as const;
	const MOUTHS = ["ᴥ", "◡", "ᴗ", "▽", "ヮ", "_", "-", " ͜ʖ"] as const;
	const SPACERS = ["", " "] as const;
	const HANDS = ["ﾉ", "ノ", "ﾉﾟ", "◞*", "づ", "𐒡"] as const;

	/**
	 * Returns a random element from the given array. If the array is empty, it
	 * returns `undefined`.
	 *
	 * @param choices - the array from to choose a random element
	 * @returns a random element from the given array
	 */
	function sample<T>(choices: readonly T[]): T {
		return choices[Math.floor(Math.random() * choices.length)]!;
	}

	class RandomKaomojiElement extends HTMLElement {
		private faceEl?: HTMLElement;
		private handEl?: HTMLElement;

		/** Randomly create a face. */
		private getFace = (): string => {
			const [edgeLeft, edgeRight] = sample(EDGE_PAIRS);
			const [eyeLeft, eyeRight] = sample(EYE_PAIRS);
			const mouth = sample(MOUTHS);
			const spacer = sample(SPACERS);

			return [edgeLeft, eyeLeft, mouth, eyeRight, edgeRight].join(spacer);
		};

		/** Randomly choose a hand. */
		private getHand = (): string => {
			return sample(HANDS);
		};

		/** Update the kaomoji and render a new random one. */
		private refresh = (): void => {
			if (this.faceEl && this.handEl) {
				this.faceEl.innerHTML = this.getFace();
				this.handEl.innerHTML = this.getHand();
			}
		};

		connectedCallback() {
			const faceEl = this.querySelector(".face");
			if (faceEl instanceof HTMLElement) this.faceEl = faceEl;

			const handEl = this.querySelector(".hand");
			if (handEl instanceof HTMLElement) this.handEl = handEl;

			this.refresh();
			this.addEventListener("click", this.refresh);
		}

		disconnectedCallback() {
			this.removeEventListener("click", this.refresh);
		}
	}

	if (!customElements.get("random-kaomoji")) {
		customElements.define("random-kaomoji", RandomKaomojiElement);
	}
</script>
